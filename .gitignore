# OS noise
.DS_Store

# Python
__pycache__/
*.pyc

# Session / skill workspaces
*-workspace/
skills/*/workspace/

# Personal scratch + temp artifacts
.scratch/
*.log
*.tmp
*.bak

# Machine-specific caches (never ship a stale local blob)
.code-review-graph/

# Eval harness generated artifacts
eval/results/

# R4 cumulative-ceiling runtime state (design §5 R4) — per-machine, never ship a
# stale window blob. Caged via scripts/l4/**; the guard writes it at runtime.
scripts/l4/.window-state.json

# Owner's per-repo autonomy arming — self-contained in-repo (not leaning on the
# owner's global ~/.config/git/ignore). A foreign clone never inherits an armed
# state, and `git add -A` never stages a local settings file.
.claude/settings.local.json
