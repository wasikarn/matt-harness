# OS noise
.DS_Store

# Python
__pycache__/
*.pyc

# Session / skill workspaces
*-workspace/
skills/*/workspace/

# Personal scratch + temp artifacts
.scratch/
*.log
*.tmp
*.bak

# Machine-specific caches (never ship a stale local blob)
.code-review-graph/

# Eval harness generated artifacts
eval/results/

# R4 cumulative-ceiling runtime state (design §5 R4) — per-machine, never ship a
# stale window blob. Caged via scripts/l4/**; the guard writes it at runtime.
scripts/l4/.window-state.json
