#!/usr/bin/env bash
# pre-commit — fast gate on staged files:
#   shell syntax (+shellcheck if installed), py_compile, JSON parse,
#   hardcoded home-path ban, harness-audit CRIT count.
# Full gauntlet runs in pre-push. Wire once: git config core.hooksPath git-hooks
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
fail=0
staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }

# 1. shell syntax
while IFS= read -r f; do
  [ -n "$f" ] || continue
  bash -n "$f" || fail=1
done < <(staged '*.sh' 'git-hooks/*')
if command -v shellcheck >/dev/null; then
  files=$(staged '*.sh' 'git-hooks/*')
  # shellcheck disable=SC2086
  [ -z "$files" ] || shellcheck -S warning $files || fail=1
fi

# 2. python
while IFS= read -r f; do
  [ -n "$f" ] || continue
  python3 -m py_compile "$f" || fail=1
done < <(staged '*.py')

# 3. JSON
while IFS= read -r f; do
  [ -n "$f" ] || continue
  python3 -m json.tool "$f" >/dev/null || { echo "pre-commit: invalid JSON: $f" >&2; fail=1; }
done < <(staged '*.json')

# 4. hardcoded home paths (repo is public); frozen history dirs exempt
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in docs/research/*|docs/post-mortems/*|docs/plans/*|CHANGELOG.md) continue ;; esac
  git show ":$f" | LC_ALL=C /usr/bin/grep -aqE '/Users/[A-Za-z]|-Users-[A-Za-z]' 2>/dev/null || continue
  echo "pre-commit: hardcoded home path in $f — use \$HOME or ~" >&2
  fail=1
done < <(staged)

# 5. harness-audit: zero CRITICAL
AUDIT="skills/meta/harness-audit/scripts/audit.sh"
if [ -f "$AUDIT" ]; then
  if ! out=$(bash "$AUDIT" . 2>&1); then
    echo "pre-commit: harness-audit CRIT findings:" >&2
    printf '%s\n' "$out" | /usr/bin/grep 'CRIT F' >&2
    fail=1
  fi
else
  echo "pre-commit: WARN $AUDIT missing, skipping harness-audit" >&2
fi

[ "$fail" -eq 0 ] || { echo "pre-commit: blocked" >&2; exit 1; }
exit 0
