{
  "dataset_name": "ship-change",
  "description": "Verify that ship-change skill correctly handles acceptance contracts and shipping gates.",
  "evals": [
    {
      "id": "ship-change-acceptance-exists",
      "task": "Given a task slug with an ACCEPTANCE.md, confirm ship-change Phase 5 runs the acceptance runner",
      "skill": "ship-change",
      "context": {
        "slug": "phase-1-safety-fixes-2026-06-12",
        "acceptance_path": ".scratch/phase-1-safety-fixes-2026-06-12/ACCEPTANCE.md"
      },
      "success_criteria": [
        "ACCEPTANCE.md exists",
        "acceptance-results.json exists",
        "At least 1 criteria passed"
      ],
      "expected_duration_seconds": 20,
      "expected_tokens": 3000,
      "tags": ["ship-change", "acceptance", "verification"],
      "eval_type": "assertion"
    },
    {
      "id": "ship-change-blocks-on-failure",
      "task": "Simulate a failing acceptance criterion and verify the ship gate blocks",
      "skill": "ship-change",
      "context": {
        "mock_slug": "eval-fake-failure",
        "mock_criterion": "false # intentionally fails"
      },
      "success_criteria": [
        "run-acceptance.py exits non-zero",
        "acceptance-results.json marks the criterion as failed",
        "ship-change Phase 5 would block (theoretical check)"
      ],
      "expected_duration_seconds": 10,
      "expected_tokens": 2000,
      "tags": ["ship-change", "gate", "blocking"],
      "eval_type": "assertion"
    },
    {
      "id": "ship-change-no-contract",
      "task": "Given a task without ACCEPTANCE.md, confirm ship-change skips machine verification",
      "skill": "ship-change",
      "context": {
        "slug": "no-contract-task"
      },
      "success_criteria": [
        "No ACCEPTANCE.md not found at expected path",
        "ship-change proceeds to human gate and skips",
        "No crash or error from missing file"
      ],
      "expected_duration_seconds": 10,
      "expected_tokens": 1500,
      "tags": ["ship-change", "edge-case", "missing-contract"],
      "eval_type": "assertion"
    }
  ]
}
