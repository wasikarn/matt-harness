{
  "dataset_name": "review-pr",
  "description": "Verify that review-pr skill routes agents correctly and tiers findings.",
  "evals": [
    {
      "id": "review-pr-route-by-aspect",
      "task": "Given a diff touching auth code, confirm review-pr Phase 3 routes security-reviewer",
      "skill": "review-pr",
      "context": {
        "diff_files": ["hooks/secret-scan.sh", "hooks/block-dangerous-git.sh"],
        "aspects": ["security"],
        "expected_agents": ["security-reviewer"]
      },
      "success_criteria": [
        "security-reviewer is in the routed agent list",
        "No code-reviewer is routed when aspects=security only (unless all)"
      ],
      "expected_duration_seconds": 15,
      "expected_tokens": 2500,
      "tags": ["review-pr", "routing", "security"],
      "eval_type": "assertion"
    },
    {
      "id": "review-pr-tier-critical",
      "task": "Confirm that a security finding in auth code is tiered Critical",
      "skill": "review-pr",
      "context": {
        "finding_type": "hardcoded-secret",
        "file": "hooks/secret-scan.sh",
        "line": 10
      },
      "success_criteria": [
        "Finding is tiered Critical",
        "Tier table in Phase 5 shows Critical count ≥ 1"
      ],
      "expected_duration_seconds": 15,
      "expected_tokens": 2500,
      "tags": ["review-pr", "tiering", "critical"],
      "eval_type": "assertion"
    },
    {
      "id": "review-pr-acceptance-cross-check",
      "task": "Confirm review-pr Phase 6 runs machine-checkable acceptance criteria before prose cross-check",
      "skill": "review-pr",
      "context": {
        "slug": "phase-1-safety-fixes-2026-06-12",
        "acceptance_md": ".scratch/phase-1-safety-fixes-2026-06-12/ACCEPTANCE.md"
      },
      "success_criteria": [
        "ACCEPTANCE.md exists",
        "acceptance-results.json exists",
        "At least 1 criteria passed"
      ],
      "expected_duration_seconds": 20,
      "expected_tokens": 3000,
      "tags": ["review-pr", "acceptance", "integration"],
      "eval_type": "assertion"
    }
  ]
}
