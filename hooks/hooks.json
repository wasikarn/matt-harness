{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "hooks": {
    "SessionStart": [
      {
        "id": "session:doctrine-bootstrap",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session/doctrine-bootstrap.sh\""
          }
        ],
        "description": "Inject METHODOLOGY.md doctrine (decision-sizing triad + reasoning scaffold) into session context"
      }
    ],
    "PostToolUse": [
      {
        "id": "advisory:observe",
        "matcher": "Bash|Write|Edit|MultiEdit",
        "description": "Advisory: append tool-call observations to per-project observations.jsonl for /learn context",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/advisory/observe.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "id": "lifecycle:pre-compact",
        "description": "Lifecycle: log compaction events to ~/.local/share/kbg/compaction-log.txt",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/lifecycle/pre-compact.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "id": "gate:bash:irrecoverable",
        "matcher": "Bash",
        "description": "Gate: block irrecoverable Bash patterns (rm -rf, push --force, --no-verify, reset --hard, clean -f)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gates/irrecoverable.sh\""
          }
        ]
      },
      {
        "id": "gate:write:path-hardcode",
        "matcher": "Write|Edit|MultiEdit",
        "description": "Gate: block hardcoded /Users/<name> paths in .sh/.py files",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gates/path-hardcode.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "stop:cost-tracker",
        "description": "Stop: track cumulative token and cost metrics per session; appends to ~/.local/share/kbg/metrics/costs.jsonl",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop/cost-tracker.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}