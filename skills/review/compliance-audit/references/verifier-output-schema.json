{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "compliance-audit verifier result",
  "type": "object",
  "required": ["requirements", "gauntlet", "scope_ok", "unexpected_files"],
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "description": "At least one requirement actually checked, required even when everything conforms — closes the vacuous-pass case where an empty list plus a trivially-clean gauntlet is schema-valid but shows no verification work.",
      "items": {
        "type": "object",
        "required": ["id", "verdict", "note", "accepted"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": ["CONFORMS", "DEVIATED", "MISSING", "UNVERIFIABLE"]
          },
          "note": {
            "type": "string"
          },
          "accepted": {
            "type": ["boolean", "null"]
          }
        }
      }
    },
    "gauntlet": {
      "type": "object",
      "required": ["command", "sha", "exit_code", "output_tail"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "exit_code": {
          "type": "integer"
        },
        "output_tail": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "scope_ok": {
      "type": "boolean"
    },
    "unexpected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
